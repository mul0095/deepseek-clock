<UserControl x:Class="DeepSeekClock.Windows.PopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="PopupActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource PopupActionButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Border x:Name="Surface" Padding="20,16,20,16" CornerRadius="16"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource SurfaceBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.30" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="HeaderDragArea" Grid.Row="0" MinHeight="36" Background="Transparent" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="7" Background="#EEF5FF" Margin="0,0,9,0">
                            <Image x:Name="BrandIcon" Width="20" Height="20" />
                        </Border>
                        <TextBlock Text="DeepSeek Clock" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PinButton" Style="{StaticResource HeaderButton}" Content="&#xE718;" ToolTip="Keep window open" AutomationProperties.Name="Keep window open" Click="Pin_OnClick" />
                        <Button x:Name="OptionsButton" Style="{StaticResource HeaderButton}" Content="&#xE712;" ToolTip="Options" AutomationProperties.Name="Options" Click="Options_OnClick" />
                        <Button x:Name="MinimizeButton" Style="{StaticResource HeaderButton}" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="Minimize_OnClick" />
                        <Button x:Name="CloseButton" Style="{StaticResource HeaderButton}" Content="&#xE8BB;" ToolTip="Hide to tray" AutomationProperties.Name="Hide to tray" Click="Hide_OnClick" />
                    </StackPanel>
                    <Border x:Name="StatusPill" Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Left" CornerRadius="14" Padding="9,5"
                            Background="{DynamicResource StatusSurfaceBrush}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="5" Height="5" Margin="0,0,6,0" Fill="{DynamicResource StatusBrush}" />
                            <TextBlock x:Name="StatusText" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource StatusBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,16,0,18">
                    <TextBlock x:Name="Eyebrow" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock x:Name="Countdown" Margin="0,2,0,2" FontSize="42" FontWeight="SemiBold" TextWrapping="NoWrap"
                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="Transition" Margin="1,0,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>

                <Border Grid.Row="2" CornerRadius="12" Padding="12,10" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="28" />
                            <RowDefinition Height="Auto" MinHeight="38" />
                            <RowDefinition Height="Auto" MinHeight="34" />
                            <RowDefinition Height="Auto" MinHeight="34" />
                            <RowDefinition Height="Auto" MinHeight="34" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Current rates" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Grid.Column="1" Text="USD / 1M tokens" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource TabSurfaceBrush}" CornerRadius="8" Padding="3" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="FlashTab" Style="{StaticResource PopupActionButton}" Content="Flash" Width="92" MinHeight="30" Click="FlashTab_OnClick" />
                                <Button x:Name="ProTab" Style="{StaticResource PopupActionButton}" Content="V4 Pro" Width="92" MinHeight="30" Click="ProTab_OnClick" />
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Input · cache hit" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="CacheHit" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Input · cache miss" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="CacheMiss" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Output" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="Output" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Margin="0,16,0,0" Padding="0,10,0,0"
                        BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="ConsoleLink" Style="{StaticResource PopupActionButton}" HorizontalAlignment="Left" MinHeight="28" FontSize="12" Content="DeepSeek Console  ↗" Foreground="{DynamicResource MutedBrush}" Click="Console_OnClick" />
                        <Button x:Name="QuitLink" Grid.Column="1" Style="{StaticResource PopupActionButton}" MinHeight="28" FontSize="12" Content="Quit" Foreground="{DynamicResource MutedBrush}" Click="Quit_OnClick" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
